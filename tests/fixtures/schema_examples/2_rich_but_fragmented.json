    {
      "@type": "FAQPage",
      "@id": "https://summit-roofing-fixture.com.au/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can you help with emergency roof repairs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Summit Roofing offers after-hours emergency roof repairs across Melbourne. Our team is available outside standard business hours to handle urgent leaks, storm damage, and structural safety issues - call 03 5550 0142 to reach our emergency line."
          }
        },
        {
          "@type": "Question",
          "name": "What kind of roof materials do you use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We work with premium COLORBONDÂ® steel and ZINCALUMEÂ® steel for metal roofing, plus a wide range of high-quality roofing tiles (including second-hand tiles matched to existing roofs). All materials meet Australian building standards and come with a 10-year workmanship warranty on installation."
          }
        },
        {
          "@type": "Question",
          "name": "How often should my roof be inspected?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend a professional roof inspection every 12-24 months for most Melbourne homes, and annually for properties in coastal areas (Mornington, Frankston, St Kilda) or near mature gum trees. Regular inspections catch cracked tiles, rusted gutters, and ridge displacement before they cause expensive water damage. Book a free inspection by calling 03 5550 0142."
          }
        },
        {
          "@type": "Question",
          "name": "What areas do you service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Summit Roofing services Melbourne and Victoria, including premium suburbs (Toorak, Brighton, Hampton, St Kilda, Caulfield, Mornington), growing areas (Berwick, Cranbourne, Pakenham, Frankston, Clyde North), and 28 additional suburbs across Melbourne's east and south-east. Contact us if your suburb isn't listed - we cover most of Greater Melbourne."
          }
        },
        {
          "@type": "Question",
          "name": "Can I request a custom roofing solution?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every roofing project is unique, so we tailor solutions based on your property type, budget, and aesthetic preferences. Our process starts with a free on-site consultation where we assess your roof, discuss material options (COLORBONDÂ®, ZINCALUMEÂ®, tile), and provide an obligation-free quote. We handle everything from new roofs and extensions to heritage tile restorations."
          }
        }
      ]
    },
